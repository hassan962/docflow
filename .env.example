# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Database (defaults match docker-compose.yml when running tools on your host)
DATABASE_URL=postgresql+psycopg://docflow_app:app_dev_pw@localhost:5432/docflow
MIGRATION_DATABASE_URL=postgresql+psycopg://docflow_owner:owner_dev_pw@localhost:5432/docflow

# LLM: Groq's OpenAI-compatible endpoint. Create a free key at https://console.groq.com/keys
# and check the model name is still offered in the Groq console.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# AWS: set to your project's selected Region (AWS Settings > View all projects > Overview).
AWS_REGION=ap-south-1

# Confidence needed to auto-approve a field, per document type.
REVIEW_THRESHOLD_INVOICE=0.90

# Your API key from the first `docker compose up` (used by scripts/demo_upload.py)
DOCFLOW_API_KEY=
